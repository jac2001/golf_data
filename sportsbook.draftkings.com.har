            "mimeType": "application/json",
            "text": "{\n  \"draftkings\": {\n    \"name\": \"Daily Fantasy\",\n    \"shortName\": \"Fantasy\",\n    \"key\": \"draftkings\",\n    \"host\": \"www.draftkings.com\",\n    \"baseHost\": \"www.draftkings.com\",\n    \"api\": \"api.draftkings.com\",\n    \"secureHost\": \"secure.draftkings.com\",\n    \"depositUrl\": \"<%= draftkings.secureHost %>/app/deposit\",\n    \"ticketsUrl\": \"<%= draftkings.host %>/tickets\",\n    \"discoverable\": true,\n    \"navItems\": [\n      {\n        \"label\": \"Lobby\",\n        \"key\": \"lobby\",\n        \"url\": \"<%= draftkings.host %>/lobby\",\n        \"hasSubNav\": true\n      },\n      {\n        \"label\": \"Lineups\",\n        \"key\": \"lineup\",\n        \"url\": \"<%= draftkings.host %>/lineup\"\n      },\n      {\n        \"label\": \"Contests\",\n        \"key\": \"mycontests\",\n        \"url\": \"<%= draftkings.host %>/mycontests\"\n      },\n      {\n        \"label\": \"Leagues\",\n        \"key\": \"leagues\",\n        \"url\": \"<%= draftkings.host %>/leagues/home\"\n      },\n      {\n        \"label\": \"Pools\",\n        \"key\": \"pools\",\n        \"url\": \"<%= draftkings.host %>/pools\"\n      },\n      {\n        \"label\": \"Rewards\",\n        \"key\": \"promotions\",\n        \"url\": \"<%= draftkings.host %>/promos\",\n        \"showWhen\": [\n          \"sidemenu\"\n        ]\n      },\n      {\n        \"label\": \"Create a Lineup\",\n        \"key\": \"createlineup\",\n        \"url\": \"<%= draftkings.host %>/lineup/createlineup\",\n        \"showWhen\": [\n          \"sidemenu\"\n        ]\n      },\n      {\n        \"label\": \"Create a Contest\",\n        \"key\": \"createcontest\",\n        \"url\": \"<%= draftkings.host %>/create-contest\",\n        \"showWhen\": [\n          \"sidemenu\"\n        ]\n      },\n      {\n        \"label\": \"Global Player Swap\",\n        \"key\": \"playerswap\",\n        \"url\": \"<%= draftkings.host %>/lineup/globalswap\",\n        \"showWhen\": [\n          \"sidemenu\"\n        ]\n      },\n      {\n        \"label\": \"Social\",\n        \"key\": \"social\",\n        \"url\": \"<%= draftkings.host %>/social\"\n      },\n      {\n        \"label\": \"Contact Us\",\n        \"key\": \"contactus\",\n        \"url\": \"https://myaccount.draftkings.com/help?fromSiteExp=<%= siteExperience %>\",\n        \"showWhen\": [\n          \"sidemenu\",\n          \"loggedOut\"\n        ]\n      }\n    ],\n    \"accountDropdownItems\": [\n      {\n        \"label\": \"Account Information\",\n        \"url\": \"https://myaccount.draftkings.com/accountcenter/information\",\n        \"external\": false\n      },\n      {\n        \"label\": \"Fantasy Preferences\",\n        \"url\": \"<%= draftkings.host %>/account/preferences\",\n        \"external\": false\n      },\n      {\n        \"label\": \"How to Play\",\n        \"url\": \"<%= draftkings.host %>/how-to-play\",\n        \"external\": false\n      },\n      {\n        \"label\": \"Rules & Scoring\",\n        \"url\": \"<%= draftkings.host %>/help/rules/overview\",\n        \"external\": false\n      },\n      {\n        \"label\": \"Help Center\",\n        \"url\": \"https://myaccount.draftkings.com/help?fromSiteExp=<%= siteExperience %>\",\n        \"external\": false\n      },\n      {\n        \"label\": \"Refer-A-Friend\",\n        \"url\": \"<%= draftkings.host %>/refer\",\n        \"external\": false\n      },\n      {\n        \"label\": \"Mobile Apps\",\n        \"url\": \"<%= draftkings.host %>/mobileapps\",\n        \"external\": false\n      },\n      {\n        \"label\": \"DK Shop\",\n        \"url\": \"https://shopdraftkings.com\",\n        \"external\": true\n      },\n      {\n        \"label\": \"DK Network\",\n        \"url\": \"<%= dklive.dkNationHost %>\",\n        \"external\": true\n      },\n      {\n        \"label\": \"Fantasy Advice\",\n        \"url\": \"<%= draftkings.host %>/playbook\",\n        \"external\": true\n      },\n      