{
  "env": {
    "NEXT_PUBLIC_API_URL": "https://golf-app-a3yw.onrender.com"
  },
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}